# Copier ce fichier en .env puis adapter. Ne jamais versionner .env.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Secret de session : générer une longue valeur aléatoire (ex. `openssl rand -base64 48`)
SESSION_SECRET=a-remplacer-par-une-longue-valeur-aleatoire

# --- Base de données (docker-compose.yml) ---
DATABASE_URL=postgresql://naatal:naatal_dev@localhost:5432/naatal?schema=public

# --- Stockage des médias, compatible S3 (MinIO en local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=naatal-medias
S3_ACCESS_KEY=naatal
S3_SECRET_KEY=naatal_dev_secret

# --- SMS (code de vérification, EF01) : fournisseur à choisir ---
SMS_PROVIDER=console
SMS_API_KEY=

# --- IA : fournisseurs à choisir sur le jeu de cas test (voir specs) ---
AI_PROVIDER=aucun
AI_API_KEY=
STT_PROVIDER=aucun
STT_API_KEY=
TTS_PROVIDER=aucun
TTS_API_KEY=

# --- Production uniquement (docker-compose.prod.yml) ---
# DOMAINE=naatal.exemple.sn
# DOMAINE_MEDIAS=medias.naatal.exemple.sn
# POSTGRES_USER=naatal
# POSTGRES_PASSWORD=mot-de-passe-fort
# POSTGRES_DB=naatal
# En production : DATABASE_URL=postgresql://naatal:mot-de-passe-fort@postgres:5432/naatal
# En production : S3_ENDPOINT=https://medias.naatal.exemple.sn
